# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# SQLite (Default for zero-setup local development & testing):
DATABASE_URL="file:./dev.db"

# PostgreSQL (For production / cloud deployment):
# DATABASE_URL="postgresql://citysaathi_user:your_password@localhost:5432/citysaathi_db?schema=public"

# Authentication & Security
JWT_SECRET=citysaathi_secure_jwt_dev_key_capstone_2026
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Google Gemini AI Integration (Optional)
# If provided, CitySaathi uses official @google/genai SDK for deep triage, rewrite, and missing detail detection.
# If omitted or network is offline, the app automatically falls back to the embedded supervised TF-IDF model.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-flash-lite-latest

# Mapping & Geolocation (100% Free-First Leaflet & OpenStreetMap)
# Uses Leaflet.js with CartoDB Dark Matter / Positron tiles + OpenStreetMap attribution.
# Reverse geocoding & manual address search powered by public OSM Nominatim (user-triggered only).
MAP_DEFAULT_LAT=12.9716
MAP_DEFAULT_LNG=77.5946
MAP_DEFAULT_ZOOM=12

# AI & Duplicate Detection Engine Thresholds
DUPLICATE_TEXT_THRESHOLD=0.45
DUPLICATE_RADIUS_METERS=600
AI_CONFIDENCE_THRESHOLD=0.45

# Python FastAPI AI Microservice (Private Localhost)
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_AI_SERVICE_TOKEN=cs_sec_token_dev_microservice_2026
AI_SERVICE_TIMEOUT_MS=3500
